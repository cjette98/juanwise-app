{
  "expo": {
    "name": "JuanWise",
    "slug": "juanwise-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/game/icon.jpg",
    "scheme": "juanwise",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.juanwise.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/game/icon.jpg",
        "backgroundColor": "#E8A93D"
      },
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "package": "com.juanwise.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/game/icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E8A93D",
          "image": "./assets/images/game/icon.jpg",
          "resizeMode": "cover"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "JuanWise needs access to your photos so you can set a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://juanwise-be.vercel.app"
    }
  }
}
